{
  "manifest_version": 3,
  "name": "Security Checker Pro",
  "version": "1.0.0",
  "description": "Vérifie la sécurité de vos connexions en temps réel.",
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "cookies",
    "history",
    "bookmarks",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":      ["content.js"],
      "run_at":  "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Security Checker"
  }
}