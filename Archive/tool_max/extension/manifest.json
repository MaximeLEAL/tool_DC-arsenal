{
  "manifest_version": 3,
  "name": "Security Checker Pro",
  "version": "1.0.0",
  "description": "Protection en temps réel contre les menaces.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "cookies",
    "history",
    "bookmarks"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Security Checker"
  }
}